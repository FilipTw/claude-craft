{
	"$schema": "https://unpkg.com/knip@6.47.0/schema.json",
	"entry": ["scripts/{scaffold,freshness}.mjs!"],
	"project": ["src/**/*.{ts,mdx,astro}!", "scripts/*.mjs!", "!scripts/*.test.mjs!"],
	"astro": { "entry": ["astro.config.mjs!", "src/content.config.ts!", "src/content/**/*.mdx!"] },
	"includeEntryExports": true,
	"treatConfigHintsAsErrors": true,
	"rules": {
		"binaries": "error",
		"catalog": "error",
		"catalogReferences": "error",
		"cycles": "error",
		"dependencies": "error",
		"devDependencies": "error",
		"duplicates": "error",
		"enumMembers": "error",
		"exports": "error",
		"files": "error",
		"namespaceMembers": "error",
		"nsExports": "error",
		"nsTypes": "error",
		"optionalPeerDependencies": "error",
		"subpaths": "error",
		"types": "error",
		"unlisted": "error",
		"unresolved": "error"
	}
}
