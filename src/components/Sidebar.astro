---
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/Sidebar.astro';

const roadmapHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/roadmap/`;
---

{/* Starlight already wraps the sidebar in <nav>, so this adds only a label and the CTA. */}
<p class="cc-sidebar-heading" aria-hidden="true">Przeglądaj tematy</p>
<Default />
<a class="cc-sidebar-cta" href={roadmapHref}>
	<span>Ścieżka nauki</span>
	<Icon name="right-arrow" size="1rem" />
</a>
