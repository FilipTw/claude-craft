---
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { percent, summarizeSidebar, totalProgress, withBase } from '../lib/home.mjs';
import { ROADMAP_ID, ROADMAP_PATH } from '../lib/pages.mjs';

const { id, sidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL;
const progress = totalProgress(summarizeSidebar(sidebar, await getCollection('docs'), base, new Date()));
const done = percent(progress.verified, progress.pages);
---

{/* Starlight already wraps the sidebar in <nav>. The card replaces the roadmap link (ADR 0003, 2026-11-24). */}
<a
	class="cc-progress-card cc-glass"
	href={withBase(base, ROADMAP_PATH)}
	aria-current={id === ROADMAP_ID ? 'page' : undefined}
	aria-label={`Ścieżka nauki: zweryfikowano ${progress.verified} z ${progress.pages} stron (${done}%)`}
>
	<span class="cc-progress-tile" aria-hidden="true">
		<span class="cc-progress-tile-value">{done}%</span>
		<span class="cc-progress-tile-label">gotowe</span>
	</span>
	<span class="cc-progress-card-text" aria-hidden="true">
		<span class="cc-progress-card-title">Ścieżka nauki</span>
		<span class="cc-progress-card-chip">{progress.verified} / {progress.pages} stron</span>
		<span class="cc-progress-card-bar"><span style={`--cc-progress: ${done}%`}></span></span>
	</span>
	<Icon name="right-arrow" size="1rem" class="cc-progress-card-arrow" />
</a>
<p class="cc-sidebar-heading" aria-hidden="true">Przeglądaj tematy</p>
<Default />
