---
import { pagePosition } from '../lib/home.mjs';
import Capsule from './Capsule.astro';

const { pagination, sidebar } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const position = pagePosition(sidebar);
---

{/* Previous capsule, position pill, next capsule (ADR 0003, third pass). An empty slot keeps the layout steady. */}
{(prev || next) && (
<nav class="cc-pagination print:hidden" aria-label="Poprzednia i następna strona">
	{prev ? (
		<Capsule class="cc-pagination-prev" href={prev.href} rel="prev" label="Poprzednia" title={prev.label} />
	) : <span class="cc-pagination-prev" aria-hidden="true"></span>}
	{position && (
		<a class="cc-page-pill" href="#_top">
			{/* The accessible name starts with the visible "3 / 193", so speech input can name the link (WCAG 2.5.3) */}
			<span class="cc-page-pill-index">{position.index}</span>
			<span class="cc-page-pill-total">/ {position.total}</span>
			<span class="sr-only">. Wróć na górę</span>
		</a>
	)}
	{next ? (
		<Capsule class="cc-pagination-next" href={next.href} rel="next" label="Następna" title={next.label} />
	) : <span class="cc-pagination-next" aria-hidden="true"></span>}
</nav>
)}
