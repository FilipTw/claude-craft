---
interface Props {
	/** Anchor target, for example "sciezka-nauki". */
	id: string;
	/** Position of this section on the page, for example "01". */
	index: string;
	/** Short label above the title, for example "Program". */
	kicker: string;
	title: string;
	lead?: string;
}

const { id, index, kicker, title, lead } = Astro.props;
---

{/* One eyebrow row (number, rule, label) over the title and lead (ADR 0003, fourth pass). */}
<header class="cc-section-heading not-content">
	<p class="cc-section-kicker">
		<span class="cc-section-number" aria-hidden="true">{index}</span>
		{kicker}
	</p>
	<h2 id={id}>{title}</h2>
	{lead && <p class="cc-section-lead">{lead}</p>}
</header>
