{
	"$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.24.2/schema/markdownlint-cli2-config-schema.json",
	"config": {
		"default": true,
		// Starlight renders the frontmatter title as the page h1, so a body h1 is a second one.
		"MD025": { "level": 1, "front_matter_title": "^\\s*title\\s*:" },
		"MD041": { "level": 1, "front_matter_title": "^\\s*title\\s*:" },
		"MD013": { "line_length": 1000, "heading_line_length": 80, "code_block_line_length": 120 },
		// Starlight components in MDX. markdownlint compares names case-insensitively, so <aside> and <code> pass too.
		"MD033": {
			"allowed_elements": [
				"Aside",
				"Badge",
				"Card",
				"CardGrid",
				"Code",
				"FileTree",
				"Icon",
				"LinkButton",
				"LinkCard",
				"Steps",
				"TabItem",
				"Tabs"
			]
		},
		"MD003": { "style": "atx" },
		"MD004": { "style": "dash" },
		"MD029": { "style": "ordered" },
		"MD035": { "style": "---" },
		"MD046": { "style": "fenced" },
		"MD048": { "style": "backtick" },
		"MD049": { "style": "underscore" },
		"MD050": { "style": "asterisk" },
		"MD055": { "style": "leading_and_trailing" },
		"MD060": { "style": "compact" }
	},
	"globs": [
		"*.md",
		"src/content/docs/**/*.{md,mdx}",
		"templates/**/*.md",
		"scripts/page-templates/*.md",
		"docs/**/*.md"
	],
	"gitignore": true
}
