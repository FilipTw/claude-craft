---
interface Props {
	/** Anchor target, for example "sciezka-nauki". */
	id: string;
	/** Position of this section on the page, for example "01". */
	index: string;
	/** Number of sections on the page, for example "03". */
	total: string;
	/** Short label above the title, for example "Program". */
	kicker: string;
	title: string;
	lead?: string;
}

const { id, index, total, kicker, title, lead } = Astro.props;
---

<header class="cc-section-heading not-content">
	<p class="cc-section-index" aria-hidden="true">
		{/* Decorative outlined numeral (WCAG 1.4.3 "pure decoration"): drawn by CSS from data-index, not DOM text. */}
		<span class="cc-section-number" data-index={index}></span>
		<span class="cc-section-total">/ {total}</span>
	</p>
	<div class="cc-section-body">
		<p class="cc-section-kicker">{kicker}</p>
		<h2 id={id}>{title}</h2>
		{lead && <p class="cc-section-lead">{lead}</p>}
	</div>
</header>
