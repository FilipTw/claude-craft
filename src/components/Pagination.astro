---
import { Icon } from '@astrojs/starlight/components';
import { pagePosition } from '../lib/home.mjs';

const { pagination, sidebar } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const position = pagePosition(sidebar);
---

{/* Previous capsule, position pill, next capsule (spec: design pass 3). An empty slot keeps the layout steady. */}
{(prev || next) && (
<nav class="cc-pagination print:hidden" aria-label="Poprzednia i następna strona">
	{prev ? (
		<a class="cc-capsule cc-capsule-start cc-pagination-prev" href={prev.href} rel="prev">
			<span class="cc-capsule-arrow" aria-hidden="true"><Icon name="left-arrow" size="1rem" /></span>
			<span class="cc-capsule-text">
				<span class="cc-capsule-label">Poprzednia<span class="sr-only">: </span></span>{" "}
				<span class="cc-capsule-title">{prev.label}</span>
			</span>
		</a>
	) : <span class="cc-pagination-prev" aria-hidden="true"></span>}
	{position && (
		<a class="cc-page-pill" href="#_top" aria-label={`Strona ${position.index} z ${position.total}. Wróć na górę`}>
			<span class="cc-page-pill-index">{position.index}</span>
			<span class="cc-page-pill-total">/ {position.total}</span>
		</a>
	)}
	{next ? (
		<a class="cc-capsule cc-pagination-next" href={next.href} rel="next">
			<span class="cc-capsule-text">
				<span class="cc-capsule-label">Następna<span class="sr-only">: </span></span>{" "}
				<span class="cc-capsule-title">{next.label}</span>
			</span>
			<span class="cc-capsule-arrow" aria-hidden="true"><Icon name="right-arrow" size="1rem" /></span>
		</a>
	) : <span class="cc-pagination-next" aria-hidden="true"></span>}
</nav>
)}
